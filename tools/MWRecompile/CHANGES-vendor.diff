+bool CEsmScriptCompile::MwrIsIdentifier(const TCHAR *pText) {
+	if (pText == NULL || *pText == NULL_CHAR) return false;
+	if (!isalpha((unsigned char)*pText) && *pText != '_') return false;
+	for (const TCHAR *p = pText; *p != NULL_CHAR; ++p) {
+		if (!isalnum((unsigned char)*p) && *p != '_') return false;
+	}
+	return true;
+}
+
+bool CEsmScriptCompile::MwrIsIDOnlyArg() {
+	if (m_pCurrentFunc == NULL || m_FuncArgIndex < 0 || m_FuncArgIndex >= MWESM_SCRIPT_MAXARGS) return false;
+	long long Arg = m_pCurrentFunc->Var[m_FuncArgIndex];
+	return (Arg & ESMSCR_FUNC_ID) != 0 && (Arg & ESMSCR_FUNC_NUMBER) == 0 && (Arg & ESMSCR_FUNC_RESET) == 0;
+}
+
+bool CEsmScriptCompile::MwrOutputZeroArgForVar() {
+	if (m_pCurrentFunc == NULL || m_FuncArgIndex < 0 || m_FuncArgIndex >= MWESM_SCRIPT_MAXARGS) return false;
+	if ((m_pCurrentFunc->Flags & ESMSCR_FUNC_VAR) != 0) return false;
+	if (GetEsmOptAllowExtFuncs()) return false; /* MWSE handles variable arguments */
+	long long Arg = m_pCurrentFunc->Var[m_FuncArgIndex];
+	if ((Arg & ESMSCR_FUNC_FLOAT) != 0 || (Arg & ESMSCR_FUNC_LONG) != 0) {
+		AddScriptData("\0\0\0\0", 4);
+	} else if ((Arg & ESMSCR_FUNC_SHORT) != 0) {
+		AddScriptData("\0\0", 2);
+	} else {
+		return false;
+	}
+	m_LastFuncArgSymbol = false;
+	return true;
+}
