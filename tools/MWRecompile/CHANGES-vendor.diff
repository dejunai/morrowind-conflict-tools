+/* MWRecompile: "set undeclared to 1" -- the CS compiles an unknown, undotted
+ * SET target as 'V' with index 1 (seen in AhniaNote, bardoor3Script,
+ * avSlavehunter, ColonyFalco); keep doing so, with a warning. */
+int CEsmScriptCompile::MwrParseSetSymbol() {
+	const TCHAR *p = m_pParse;
+
+	while (*p == ' ' || *p == '\t') {
+		++p;
+	}
+
+	if (*p != '.' && !IsSymbolID(m_Token)) {
+		AddMessage(ESMSCR_WARNING_BADFUNCVAR, _T("Unknown variable '%s' in SET (the CS compiles it as an undefined variable)."), (const TCHAR *)m_Token);
+		AddScriptData("V\1\0", 3);
+		AddScriptData("\0", 1);
+		m_LastSetPos = m_ScriptDataSize - 1;
+		m_TokenParsed = true;
+		return ESMSCR_RESULT_TABLEEND;
+	}
+
+	return ParseSymbolID();
+}
