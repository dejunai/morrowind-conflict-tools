+ * functions declared with a generic ID argument, and a GetPCCell name that
+ * is not a cell but a dialogue topic gives ' d'). */
+const TCHAR *CEsmScriptCompile::MwrRefTypeForID(const long long ArgFlags, const TCHAR *pID) {
+	const TCHAR *pType = GetFuncArgRefType(ArgFlags);
+	const TCHAR *pWantType = NULL;
+
+	if (pID == NULL || m_pDocument == NULL) {
+		return pType;
+	}
+
+	if (strcmp(pType, _T(" c")) == 0) pWantType = MWESM_REC_CELL;
+	else if (strcmp(pType, _T(" t")) == 0) pWantType = MWESM_REC_FACT;
+	else if (strcmp(pType, _T(" a")) == 0) pWantType = MWESM_REC_RACE;
+	else if (strcmp(pType, _T(" d")) == 0) pWantType = MWESM_REC_DIAL;
+
+	if (pWantType != NULL) {
+		/* The expected kind of record exists: normal case */
+		if (m_pDocument->FindRecord(pID, pWantType) != NULL) return pType;
+
+		/* Otherwise the CS uses the kind of record the ID really names
+		 * (GetPCRank "House Telvanni" -> ' d' for the dialogue topic) */
+		if (m_pDocument->FindRecord(pID, MWESM_REC_DIAL) != NULL) return _T(" d");
+		if (m_pDocument->FindRecord(pID, MWESM_REC_FACT) != NULL) return _T(" t");
+		if (m_pDocument->FindRecord(pID, MWESM_REC_RACE) != NULL) return _T(" a");
+		return pType;
+	}
+
+	if (strcmp(pType, _T(" r")) == 0 && (m_pCurrentFunc == NULL || m_pCurrentFunc->OpCode != 0x114e)) {
+		if (m_pDocument->FindObjectRecord(pID) == NULL) {
+			if (m_pDocument->FindRecord(pID, MWESM_REC_FACT) != NULL) return _T(" t");
+			if (m_pDocument->FindRecord(pID, MWESM_REC_RACE) != NULL) return _T(" a");
+		}
+	}
+
+	return pType;
+}
