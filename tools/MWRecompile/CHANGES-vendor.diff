+/* MWRecompile: a bare ID in an IF expression ("if ( BM_BearHunt1 == 0 )")
+ * is written by the CS as a typed reference: ' d' + length + ID. */
+int CEsmScriptCompile::MwrParseIfSymbol() {
+	const TCHAR *p = m_pParse;
+
+	while (*p == ' ' || *p == '\t') {
+		++p;
+	}
+
+	if (*p == '.' || (p[0] == '-' && p[1] == '>') || m_pDocument == NULL) {
+		return ParseSymbolID();
+	}
+
+	const TCHAR *pType = NULL;
+	esmrecinfo_t *pRecord = NULL;
+
+	if ((pRecord = m_pDocument->FindRecord(m_Token, MWESM_REC_DIAL)) != NULL) pType = _T(" d");
+	else if ((pRecord = m_pDocument->FindRecord(m_Token, MWESM_REC_FACT)) != NULL) pType = _T(" t");
+	else if ((pRecord = m_pDocument->FindRecord(m_Token, MWESM_REC_RACE)) != NULL) pType = _T(" a");
+	else if ((pRecord = m_pDocument->FindObjectRecord(m_Token)) != NULL) pType = _T(" r");
+
+	if (pType == NULL) {
+		return ParseSymbolID();
+	}
+
+	AddMessage(ESMSCR_WARNING_BADFUNCVAR, _T("ID '%s' used as a value in an expression (compiled as the CS does)."), (const TCHAR *)m_Token);
+	byte Len = (byte)m_Token.GetLength();
+	AddScriptData(pType, 2);
+	AddScriptData(&Len, 1);
+	AddScriptData((const TCHAR *)m_Token, Len);
+	m_IsEmptyIf = false;
+	m_TokenParsed = true;
+	return ESMSCR_RESULT_TABLEEND;
+}
